# Rendered by the nginx image at startup (envsubst replaces ${PORT} only).
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml application/octet-stream;

    # Clean URLs like Firebase Hosting: /compro -> /compro.html
    location / {
        try_files $uri $uri.html $uri/index.html =404;
        add_header Cache-Control "no-cache";
    }

    # Runtime config: never cache.
    location = /env.js {
        add_header Cache-Control "no-store";
    }

    # Content-hashed bundles.
    location ^~ /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 3D models, videos, images and data files.
    location ~* \.(?:glb|stl|mp4|png|jpe?g|gif|webp|svg|ico|json)$ {
        add_header Cache-Control "public, max-age=86400";
    }

    error_page 404 /404.html;
}
